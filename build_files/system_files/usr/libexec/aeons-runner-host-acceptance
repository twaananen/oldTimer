#!/usr/bin/env bash
set -euo pipefail

if (( EUID != 0 )); then
    echo "run as root: sudo /usr/libexec/aeons-runner-host-acceptance" >&2
    exit 1
fi
if systemctl is-active --quiet aeons-runnerd.service; then
    echo "refusing to probe while aeons-runnerd is active" >&2
    echo "stop it only when no Actions job is active, then rerun this probe" >&2
    exit 1
fi
for service in aeons-ci-firewall.service aeons-runner-image.service; do
    if ! systemctl is-active --quiet "$service"; then
        echo "$service must be active" >&2
        exit 1
    fi
done
counter_value() {
    local marker=$1
    nft --json list chain inet aeons_ci output |
        jq --arg marker "$marker" \
            '[.nftables[].rule | select(.comment == $marker) | .expr[]? | select(has("counter")) | .counter.packets] | if length == 1 then .[0] else error("missing or duplicate counter") end'
}
markers=(
    aeons-ci-probe-host-local
    aeons-ci-probe-lan-gateway
    aeons-ci-probe-docker-bridge
    aeons-ci-probe-carrier-grade
    aeons-ci-probe-link-local
    aeons-ci-probe-ipv6
)
declare -A counter_before
for marker in "${markers[@]}"; do
    counter_before[$marker]=$(counter_value "$marker")
done

systemd-run \
    --quiet \
    --wait \
    --pipe \
    --collect \
    --unit=aeons-runner-host-acceptance-worker.service \
    --property=Type=exec \
    --property=User=aeons-ci \
    --property=Group=aeons-ci \
    --property=Slice=aeons-ci.slice \
    --property=Delegate=yes \
    --setenv=HOME=/var/lib/aeons-ci \
    --setenv=XDG_RUNTIME_DIR=/run/aeons-ci \
    /usr/libexec/aeons-runner-host-acceptance-worker

for marker in "${markers[@]}"; do
    counter_after=$(counter_value "$marker")
    if (( counter_after <= counter_before[$marker] )); then
        echo "probe did not reach its aeons_ci nftables reject: $marker" >&2
        exit 1
    fi
done
echo "PASS: four-runner host isolation, slice ancestry, egress, and exact cleanup"
