[Unit]
Description=Aeons CI private-network egress denial
Requires=aeons-ci-host-setup.service
After=aeons-ci-host-setup.service
Before=aeons-runner-image.service aeons-runnerd.service

[Service]
Type=oneshot
ExecStartPre=-/usr/sbin/nft delete table inet aeons_ci
ExecStart=/usr/sbin/nft --file /usr/lib/aeons-ci/network.nft
ExecStop=-/usr/sbin/nft delete table inet aeons_ci
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
