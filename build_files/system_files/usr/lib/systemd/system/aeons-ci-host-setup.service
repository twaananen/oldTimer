[Unit]
Description=Prepare the Aeons CI rootless user namespace
Requires=systemd-sysusers.service
After=systemd-sysusers.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/aeons-ci-host-setup
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/subuid /etc/subgid /run/lock
