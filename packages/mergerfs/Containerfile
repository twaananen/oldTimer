ARG BUILDER_IMAGE
FROM ${BUILDER_IMAGE} AS build
RUN dnf5 install -y gcc-c++ git rpm-build make curl which libatomic findutils \
    && dnf5 clean all
COPY build.sh smoke-test.sh /recipe/
ARG VERSION
ARG SOURCE_SHA256
RUN bash /recipe/build.sh

FROM ${BUILDER_IMAGE}
COPY --from=build /output /output
COPY smoke-test.sh /recipe/
ARG VERSION
RUN dnf5 install -y fuse /output/package.rpm && dnf5 clean all \
    && test "$(rpm -q --qf '%{VERSION} %{ARCH}' mergerfs)" = "${VERSION} x86_64" \
    && mergerfs --version
